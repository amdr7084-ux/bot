DISCORD_TOKEN=your_discord_bot_token_here
PROTECTED_CHANNEL_ID=your_protected_channel_id_here
LOG_CHANNEL_ID=your_log_channel_id_here
# Comma-separated user IDs that are exempt from protections
EXEMPT_USER_IDS=123456789012345678,987654321098765432

# Optional deployment-related variables (used by deploy scripts / CI)
# DO NOT commit real secrets to the repository. Set these in your host/CI secrets.
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=
DOCKER_IMAGE_NAME=yourdockerhubuser/attachments:latest
WISPBYTE_DEPLOY_URL=
WISPBYTE_API_KEY=
# Security: define forbidden patterns (comma-separated). Each item can be a simple substring
# or a JavaScript-style regex string. Examples:
# FORBIDDEN_PATTERNS=^!eval,/sudo\\s+rm\\s+-rf/,token
# Action to take when a forbidden pattern is matched: 'warn' (default) or 'ban'
FORBIDDEN_PATTERNS=
PROTECTED_ACTION=warn

# DO NOT put real bot tokens into the repo. Set `DISCORD_TOKEN` in your host/CI secrets or Wispbyte env.
DISCORD_TOKEN=ضع_توكن_البوت_هنا
PROTECTED_CHANNEL_ID=ضع_ايدي_الروم_هنا
LOG_CHANNEL_ID=ضع_ايدي_روم_اللوق_هنا
EXEMPT_USER_IDS=