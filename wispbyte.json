{
  "name": "attachments-bot",
  "image": "${DOCKER_IMAGE_NAME}",
  "env": {
    "DISCORD_TOKEN": "${DISCORD_TOKEN}",
    "PROTECTED_CHANNEL_ID": "${PROTECTED_CHANNEL_ID}",
    "LOG_CHANNEL_ID": "${LOG_CHANNEL_ID}",
    "EXEMPT_USER_IDS": "${EXEMPT_USER_IDS}",
    "NODE_ENV": "production"
  },
  "resources": {
    "cpu": "500m",
    "memory": "512Mi"
  },
  "restartPolicy": {
    "type": "on-failure",
    "maxRetries": 5
  }
}
